<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Internet for Directions API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock for background work -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Detect USB / power connection (Android Auto) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CommuteApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommuteChecker">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run setup -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:label="@string/setup_title"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Places management -->
        <activity
            android:name=".ui.PlacesActivity"
            android:exported="false"
            android:label="Places"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Watches management -->
        <activity
            android:name=".ui.WatchesActivity"
            android:exported="false"
            android:label="Commute Watches"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Watch editor -->
        <activity
            android:name=".ui.WatchEditorActivity"
            android:exported="false"
            android:label="Watch"
            android:parentActivityName=".ui.WatchesActivity" />

        <!-- Location Picker Activity -->
        <activity
            android:name=".ui.LocationPickerActivity"
            android:exported="false"
            android:label="@string/pick_location" />

        <!-- Android Auto Connection Receiver -->
        <receiver
            android:name=".receiver.AndroidAutoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.POWER_CONNECTED" />
                <action android:name="android.intent.action.POWER_DISCONNECTED" />
                <action android:name="android.app.action.ENTER_CAR_MODE" />
                <action android:name="androidx.car.app.connection.action.CAR_CONNECTION_UPDATED" />
            </intent-filter>
        </receiver>

        <!-- Boot receiver to re-register listeners -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service for commute checking -->
        <service
            android:name=".service.CommuteCheckService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Android Auto CarAppService -->
        <service
            android:name=".auto.CommuteCarAppService"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!-- Android Auto notification listener -->
        <meta-data
            android:name="androidx.car.app.notification.CarAppExtender"
            android:value="true" />

        <!-- Android Auto descriptor -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Required minimum Car App API level -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

    </application>

</manifest>
